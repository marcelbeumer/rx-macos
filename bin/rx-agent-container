#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/rx-guard-agent-cwd"

# usage: rx-agent-container [--runtime podman|docker] <cmd> [args...]
runtime="podman"
extra_mounts=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -r|--runtime) runtime="$2"; shift 2 ;;
    -v|--volume) extra_mounts+=(-v "$2"); shift 2 ;;
    *) break ;;
  esac
done

if ! command -v "$runtime" >/dev/null 2>&1; then
  echo "ERROR: runtime \"$runtime\" not found" >&2
  exit 1
fi

userns_args=()
[[ "$runtime" == "podman" ]] && userns_args=(--userns=keep-id)

cmd="${1:-}"
shift

if [[ "${HERDR_ENV:-}" == "1" && ( "$cmd" == "opencode" || "$cmd" == "pi" ) ]]; then
  export HERDR_AGENT="$cmd"
  herdr pane report-metadata "${HERDR_PANE_ID:-}" --source "rx:container" \
    --display-agent "$cmd (container)" 2>/dev/null || true
fi

exec "$runtime" run -it --rm \
  --user agent \
  "${userns_args[@]}" \
  --cap-drop=ALL \
  -v "$(pwd)":/workspace \
  -v "$HOME/g/allow:/home/agent/g/allow" \
  -v "$HOME/g/ask:/home/agent/g/ask" \
  -v "$HOME/.local/share/opencode:/home/agent/.local/share/opencode" \
  -v "$HOME/.local/state/opencode:/home/agent/.local/state/opencode" \
  -v "$HOME/.local/share/rx/agents/opencode:/home/agent/.config/opencode" \
  -v "$HOME/.local/share/rx/agents/pi:/home/agent/.pi" \
  -v "$HOME/.local/share/rx/agents/config/sandbox/AGENTS.md:/home/agent/.config/opencode/AGENTS.md" \
  -v "$HOME/.local/share/rx/agents/config/sandbox/AGENTS.md:/home/agent/.pi/agent/AGENTS.md" \
  -v "$HOME/.local/share/rx/dotfiles/agents:/home/agent/.agents" \
  "${extra_mounts[@]}" \
  rx-agent-box \
  "$cmd" "$@"
